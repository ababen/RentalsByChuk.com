# Lead delivery — copy to `.env.local` (or Vercel → Project → Settings → Environment Variables)

# Option A: send every lead to a webhook (Zapier, Make, GoHighLevel, Follow Up Boss, Slack…)
LEAD_WEBHOOK_URL=

# Option B: email every lead via Resend (https://resend.com — free tier is fine)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=chuk@rentalsbychuk.com
# Sender must be on a domain verified in Resend:
LEAD_FROM_EMAIL="RentalsByChuk Leads <leads@rentalsbychuk.com>"

# Optional: Google Analytics 4 measurement ID (enables GA + generate_lead events)
NEXT_PUBLIC_GA_ID=
