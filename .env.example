# Lead delivery — copy to `.env.local` (or Vercel → Project → Settings → Environment Variables)

# Option A: send every lead to a webhook (Zapier, Make, GoHighLevel, Follow Up Boss, Slack…)
LEAD_WEBHOOK_URL=

# Option B: email every lead to LEAD_NOTIFY_EMAIL
LEAD_NOTIFY_EMAIL=homesbychuk@gmail.com
# B1 (preferred): Cloudflare Email Sending — token from dash.cloudflare.com/profile/api-tokens
# with Account → Email Sending → Edit. Free when sending to a verified destination address.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
# B2: Resend (https://resend.com) — used only when the Cloudflare vars are empty
RESEND_API_KEY=
# Resend sender must be on a domain verified in Resend:
LEAD_FROM_EMAIL="RentalsByChuk Leads <leads@rentalsbychuk.com>"

# Optional: Google Analytics 4 measurement ID (enables GA + generate_lead events)
NEXT_PUBLIC_GA_ID=
